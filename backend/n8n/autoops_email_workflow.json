{
  "name": "ArchiShield AutoOps Compliance Email Alert",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "archishield-autoops",
        "options": {}
      },
      "name": "AutoOps Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "archishield-autoops-webhook"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.nbc_status }}",
              "value2": "FAILED"
            }
          ]
        }
      },
      "name": "Compliance FAILED?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "emailSubject",
              "value": "=⚠️ ArchiShield AutoOps Compliance Alert: {{ $json.body.model_name || 'IFC Model' }} FAILED"
            },
            {
              "name": "emailBody",
              "value": "=ArchiShield AutoOps Compliance Alert\n\nModel: {{ $json.body.model_name }}\nHealth Score: {{ $json.body.health_score }}%\nNBC Compliance: {{ $json.body.compliance_score }}%\nStatus: {{ $json.body.nbc_status }}\nCompliance Threshold: {{ $json.body.compliance_threshold }}%\n\nIssues Breakdown (Total: {{ $json.body.total_issues || 0 }}):\nCritical: {{ $json.body.critical_issues || 0 }}\nHigh: {{ $json.body.high_issues || 0 }}\nMedium: {{ $json.body.medium_issues || 0 }}\nLow: {{ $json.body.low_issues || 0 }}\n\nBCF File:\n{{ $json.body.bcf_url }}\n\nFull PDF Report:\n{{ $json.body.report_url }}\n\nThis alert was automatically generated by ArchiShield AutoOps."
            }
          ]
        },
        "options": {}
      },
      "name": "Format Alert Message",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [720, 200]
    },
    {
      "parameters": {
        "sendTo": "admin@archishield.app",
        "subject": "={{ $json.emailSubject }}",
        "message": "={{ $json.emailBody }}",
        "options": {}
      },
      "name": "Gmail Alert",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [940, 200],
      "credentials": {
        "gmailOAuth2": {
          "id": "gmail_oauth_credential",
          "name": "Gmail Account"
        }
      }
    }
  ],
  "connections": {
    "AutoOps Webhook": {
      "main": [
        [
          {
            "node": "Compliance FAILED?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Compliance FAILED?": {
      "main": [
        [
          {
            "node": "Format Alert Message",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Format Alert Message": {
      "main": [
        [
          {
            "node": "Gmail Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
